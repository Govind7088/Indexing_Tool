# ---- Database (MySQL) ----
DB_NAME=indexing_tool_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ---- Django ----
# Secret key banane ke liye (PowerShell):  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Google Search Console (URL Inspection API) ----
# False rakho to tool sirf URL save karta hai, Google ko kuch nahi bhejta.
GOOGLE_ENABLED=False
# True karne se pehle README ka "Google setup" section poora karo.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# Indexing API sirf job/livestream pages ke liye hai. Normal URL ke liye False hi rakho.
GOOGLE_INDEXING_API_ENABLED=False